digraph DER {
graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.4, ranksep=1, label="Raízes do Nordeste — Modelo relacional", labelloc=t, fontsize=22];
node [shape=plain, fontname="DejaVu Sans", fontsize=11]; edge [fontname="DejaVu Sans", fontsize=10];
produtos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#174b51"><FONT COLOR="white"><B>produtos</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id: INTEGER</TD></TR><TR><TD ALIGN="LEFT">nome: VARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT">descricao: VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT">preco: NUMERIC(10, 2)</TD></TR><TR><TD ALIGN="LEFT">ativo: BOOLEAN</TD></TR></TABLE>>];
promocoes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#174b51"><FONT COLOR="white"><B>promocoes</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id: INTEGER</TD></TR><TR><TD ALIGN="LEFT">nome: VARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT">descricao: VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT">percentual_desconto: INTEGER</TD></TR><TR><TD ALIGN="LEFT">ativa: BOOLEAN</TD></TR></TABLE>>];
unidades [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#174b51"><FONT COLOR="white"><B>unidades</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id: INTEGER</TD></TR><TR><TD ALIGN="LEFT">nome: VARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT">cidade: VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT">uf: VARCHAR(2)</TD></TR><TR><TD ALIGN="LEFT">cozinha_completa: BOOLEAN</TD></TR><TR><TD ALIGN="LEFT">ativa: BOOLEAN</TD></TR></TABLE>>];
usuarios [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#174b51"><FONT COLOR="white"><B>usuarios</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id: INTEGER</TD></TR><TR><TD ALIGN="LEFT">nome: VARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT">UQ email: VARCHAR(180)</TD></TR><TR><TD ALIGN="LEFT">senha_hash: VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT">perfil: VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">consentimento_fidelidade: BOOLEAN</TD></TR><TR><TD ALIGN="LEFT">ativo: BOOLEAN</TD></TR><TR><TD ALIGN="LEFT">created_at: DATETIME</TD></TR></TABLE>>];
auditoria [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#174b51"><FONT COLOR="white"><B>auditoria</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id: INTEGER</TD></TR><TR><TD ALIGN="LEFT">FK usuario_id: INTEGER ?</TD></TR><TR><TD ALIGN="LEFT">acao: VARCHAR(80)</TD></TR><TR><TD ALIGN="LEFT">recurso: VARCHAR(80)</TD></TR><TR><TD ALIGN="LEFT">recurso_id: VARCHAR(60) ?</TD></TR><TR><TD ALIGN="LEFT">detalhes: TEXT ?</TD></TR><TR><TD ALIGN="LEFT">created_at: DATETIME</TD></TR></TABLE>>];
usuarios -> auditoria [label="usuario_id (1:N)"];
estoques [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#174b51"><FONT COLOR="white"><B>estoques</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id: INTEGER</TD></TR><TR><TD ALIGN="LEFT">FK unidade_id: INTEGER</TD></TR><TR><TD ALIGN="LEFT">FK produto_id: INTEGER</TD></TR><TR><TD ALIGN="LEFT">quantidade: INTEGER</TD></TR><TR><TD ALIGN="LEFT">atualizado_em: DATETIME</TD></TR></TABLE>>];
unidades -> estoques [label="unidade_id (1:N)"];
produtos -> estoques [label="produto_id (1:N)"];
fidelidade [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#174b51"><FONT COLOR="white"><B>fidelidade</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id: INTEGER</TD></TR><TR><TD ALIGN="LEFT">FK UQ usuario_id: INTEGER</TD></TR><TR><TD ALIGN="LEFT">pontos: INTEGER</TD></TR><TR><TD ALIGN="LEFT">atualizado_em: DATETIME</TD></TR></TABLE>>];
usuarios -> fidelidade [label="usuario_id (1:0..1)"];
pedidos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#174b51"><FONT COLOR="white"><B>pedidos</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id: INTEGER</TD></TR><TR><TD ALIGN="LEFT">FK cliente_id: INTEGER</TD></TR><TR><TD ALIGN="LEFT">FK unidade_id: INTEGER</TD></TR><TR><TD ALIGN="LEFT">canal_pedido: VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">status: VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">total: NUMERIC(10, 2)</TD></TR><TR><TD ALIGN="LEFT">created_at: DATETIME</TD></TR><TR><TD ALIGN="LEFT">updated_at: DATETIME</TD></TR></TABLE>>];
usuarios -> pedidos [label="cliente_id (1:N)"];
unidades -> pedidos [label="unidade_id (1:N)"];
itens_pedido [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#174b51"><FONT COLOR="white"><B>itens_pedido</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id: INTEGER</TD></TR><TR><TD ALIGN="LEFT">FK pedido_id: INTEGER</TD></TR><TR><TD ALIGN="LEFT">FK produto_id: INTEGER</TD></TR><TR><TD ALIGN="LEFT">quantidade: INTEGER</TD></TR><TR><TD ALIGN="LEFT">preco_unitario: NUMERIC(10, 2)</TD></TR></TABLE>>];
pedidos -> itens_pedido [label="pedido_id (1:N)"];
produtos -> itens_pedido [label="produto_id (1:N)"];
pagamentos [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#174b51"><FONT COLOR="white"><B>pagamentos</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK id: INTEGER</TD></TR><TR><TD ALIGN="LEFT">FK UQ pedido_id: INTEGER</TD></TR><TR><TD ALIGN="LEFT">status: VARCHAR(20)</TD></TR><TR><TD ALIGN="LEFT">provedor: VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT">referencia_externa: VARCHAR(80) ?</TD></TR><TR><TD ALIGN="LEFT">payload_retorno: TEXT ?</TD></TR><TR><TD ALIGN="LEFT">processado_em: DATETIME ?</TD></TR></TABLE>>];
pedidos -> pagamentos [label="pedido_id (1:0..1)"];
}
