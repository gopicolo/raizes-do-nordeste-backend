  "components": {
    "schemas": {
      "CanalPedido": {
        "type": "string",
        "enum": [
          "APP",
          "TOTEM",
          "BALCAO",
          "PICKUP",
          "WEB"
        ],
        "title": "CanalPedido"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ItemPedidoEntrada": {
        "properties": {
          "produtoId": {
            "type": "integer",
            "title": "Produtoid"
          },
          "quantidade": {
            "type": "integer",
            "maximum": 50.0,
            "exclusiveMinimum": 0.0,
            "title": "Quantidade"
          }
        },
        "type": "object",
        "required": [
          "produtoId",
          "quantidade"
        ],
        "title": "ItemPedidoEntrada"
      },
      "LoginEntrada": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "senha": {
            "type": "string",
            "title": "Senha"
          }
        },
        "type": "object",
        "required": [
          "email",
          "senha"
        ],
        "title": "LoginEntrada"
      },
      "MovimentoEstoqueEntrada": {
        "properties": {
          "unidadeId": {
            "type": "integer",
            "title": "Unidadeid"
          },
          "produtoId": {
            "type": "integer",
            "title": "Produtoid"
          },
          "quantidade": {
            "type": "integer",
            "title": "Quantidade"
          },
          "motivo": {
            "type": "string",
            "maxLength": 120,
            "minLength": 3,
            "title": "Motivo"
          }
        },
        "type": "object",
        "required": [
          "unidadeId",
          "produtoId",
          "quantidade",
          "motivo"
        ],
        "title": "MovimentoEstoqueEntrada"
      },
      "PagamentoEntrada": {
        "properties": {
          "resultado": {
            "$ref": "#/components/schemas/StatusPagamento"
          }
        },
        "type": "object",
        "required": [
          "resultado"
        ],
        "title": "PagamentoEntrada"
      },
      "PedidoCriacao": {
        "properties": {
          "unidadeId": {
            "type": "integer",
            "title": "Unidadeid"
          },
          "canalPedido": {
            "$ref": "#/components/schemas/CanalPedido"
          },
          "itens": {
            "items": {
              "$ref": "#/components/schemas/ItemPedidoEntrada"
            },
            "type": "array",
            "minItems": 1,
            "title": "Itens"
          },
          "formaPagamento": {
            "type": "string",
            "title": "Formapagamento",
            "default": "MOCK"
          }
        },
        "type": "object",
        "required": [
          "unidadeId",
          "canalPedido",
          "itens"
        ],
        "title": "PedidoCriacao"
      },
      "ResgateFidelidadeEntrada": {
        "properties": {
          "pontos": {
            "type": "integer",
            "maximum": 2147483647.0,
            "exclusiveMinimum": 0.0,
            "title": "Pontos"
          }
        },
        "type": "object",
        "required": [
          "pontos"
        ],
        "title": "ResgateFidelidadeEntrada"
      },
      "StatusPagamento": {
        "type": "string",
        "enum": [
          "PENDENTE",
          "APROVADO",
          "RECUSADO"
        ],
        "title": "StatusPagamento"
      },
      "StatusPedido": {
        "type": "string",
        "enum": [
          "AGUARDANDO_PAGAMENTO",
          "PAGO",
          "EM_PREPARO",
          "PRONTO",
          "ENTREGUE",
          "CANCELADO",
          "PAGAMENTO_RECUSADO"
        ],
        "title": "StatusPedido"
      },
      "StatusPedidoEntrada": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/StatusPedido"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "StatusPedidoEntrada"
      },
      "TokenSaida": {
        "properties": {
          "accessToken": {
            "type": "string",
            "title": "Accesstoken"
          },
          "tokenType": {
            "type": "string",
            "title": "Tokentype",
            "default": "Bearer"
          },
          "expiresIn": {
            "type": "integer",
            "title": "Expiresin"
          },
          "user": {
            "additionalProperties": true,
            "type": "object",
            "title": "User"
          }
        },
        "type": "object",
        "required": [
          "accessToken",
          "expiresIn",
          "user"
        ],
        "title": "TokenSaida"
      },
      "UsuarioCadastro": {
        "properties": {
          "nome": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Nome"
          },
          "email": {
            "type": "string",
            "maxLength": 180,
            "minLength": 5,
            "title": "Email"
          },
          "senha": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8,
            "title": "Senha"
          },
          "consentimentoFidelidade": {
            "type": "boolean",
            "title": "Consentimentofidelidade",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "nome",
          "email",
          "senha"
        ],
        "title": "UsuarioCadastro"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
