    {
      "name": "01 - Autenticação e autorização",
      "item": [
        {
          "name": "T01 - Login válido (cliente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente@raizes.local\",\n  \"senha\": \"Cliente@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
                  "pm.environment.set(\"tokenCliente\", pm.response.json().accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
